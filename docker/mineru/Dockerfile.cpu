# CPU-only MinerU 3.x image (pipeline backend OCR) used by the optional
# "mineru" docker-compose profile. Build with:
#   docker build -f docker/mineru/Dockerfile.cpu -t mineru-cpu .
#   # then in .env: MINERU_IMAGE=mineru-cpu  and start `docker compose --profile mineru up -d`
#
# First OCR request downloads pipeline/OCR weights from ModelScope on demand
# (several GB, slow first run). This image targets CPU; for GPU use the
# official MinerU docker/china/Dockerfile build instead and leave MINERU_IMAGE
# unset (mineru:latest).
FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    MINERU_MODEL_SOURCE=modelscope

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        curl \
        ca-certificates \
        libgl1 \
        libglib2.0-0 \
        libgomp1 \
    && rm -rf /var/lib/apt/lists/*

# Install CPU builds of torch first so mineru[pipeline] does not pull CUDA wheels.
RUN pip install --index-url https://download.pytorch.org/whl/cpu \
        "torch>=2.6,<3" \
        "torchvision>=0.21"

RUN pip install "mineru[pipeline]>=3.4,<4"

EXPOSE 8000

# The docker-compose "mineru-api" service overrides entrypoint/command and adds
# a healthcheck; a standalone run looks like:
#   docker run --rm -p 8002:8000 mineru-cpu mineru-api --host 0.0.0.0 --port 8000
