# ---- App ----
KB_ENV=dev
KB_DEBUG=true
KB_AUTO_CREATE_TABLES=true
KB_CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ---- PostgreSQL ----
KB_DATABASE_URL=postgresql+asyncpg://kb:kb@localhost:5432/kb
KB_DB_POOL_SIZE=10
KB_DB_MAX_OVERFLOW=40

# ---- Redis ----
KB_REDIS_URL=redis://localhost:6379/0
KB_RATE_LIMIT_PER_MINUTE=60
KB_RATE_LIMIT_ENABLED=true

# ---- DeepSeek (generation LLM) ----
KB_LLM_BASE_URL=https://api.deepseek.com
KB_LLM_API_KEY=sk-xxxxxxxxxxxxxxxx
KB_LLM_MODEL=deepseek-v4-flash
KB_LLM_TEMPERATURE=0.2

# ---- Local model service (Xinference) ----
KB_EMBEDDER_BASE_URL=http://localhost:9997/v1
KB_EMBEDDER_API_KEY=xinference-local
KB_EMBEDDER_MODEL=bge-m3
KB_RERANKER_BASE_URL=http://localhost:9997/v1
KB_RERANKER_MODEL=bge-reranker-v2-m3
KB_RERANK_MAX_CONCURRENCY=10
# GPU can raise rerank concurrency (e.g. 32); keep 10 on CPU.

# ---- Milvus ----
KB_MILVUS_URI=http://localhost:19530
KB_MILVUS_COLLECTION=kb_chunks_v2
KB_MILVUS_VECTOR_DIM=1024

# ---- Retrieval tuning (initial defaults, tune on real corpus) ----
KB_RETRIEVAL_TOP_N=20
KB_RETRIEVAL_TOP_K=3
KB_RERANK_MIN_SCORE=0.0
KB_CHUNK_SIZE=800
KB_CHUNK_OVERLAP=80
KB_CHUNKER_VERSION=structure-v1
# Embedding batch size per request. CPU: 32; GPU: 128 is a good starting point.
KB_EMBED_BATCH_SIZE=32
KB_HISTORY_TURNS=5
KB_RETRIEVAL_CACHE_TTL=300

# ---- Storage ----
KB_DOCUMENT_STORAGE_DIR=./data/documents
KB_QUEUE_KEY=kb:ingestion:jobs
KB_QUEUE_PROCESSING_KEY=kb:ingestion:processing

# ---- MinerU OCR (optional; only enable when a mineru-api service is running) ----
# Images (.png/.jpg/.jpeg) and scanned PDFs are parsed through this service.
# In docker-compose with the "mineru" profile: http://mineru:8000
# For a locally started mineru-api:                      http://127.0.0.1:8002
KB_MINERU_URL=
# KB_MINERU_API_KEY=            # only if MinerU sits behind a token gateway
# KB_MINERU_TIMEOUT_SECONDS=3600
# KB_MINERU_POLL_INTERVAL=3.0
# KB_MINERU_LANG=ch
# KB_MINERU_BACKEND=pipeline    # pipeline=CPU/GPU classic OCR; hybrid/vlm later
# KB_MINERU_TABLE_ENABLE=true
# KB_MINERU_FORMULA_ENABLE=false
# MINERU_IMAGE=mineru-cpu       # docker-compose: use the CPU image from docker/mineru/Dockerfile.cpu
